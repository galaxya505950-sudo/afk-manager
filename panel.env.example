# Einstellungen fuer den AFK Manager.
# Kopieren nach "panel.env" und ausfuellen. panel.env wird nie hochgeladen.
#
# Benutzer und Passwoerter gibt es hier nicht - die legst du im Panel unter
# "Verwaltung" an. Beim ersten Start steht ein Einrichtungscode im Terminal.

# Discord (optional). Leer lassen = ohne Discord.
DISCORD_TOKEN=

# Nur noetig, wenn der Bot auf mehreren Discord-Servern ist:
# DISCORD_GUILD_ID=

# Kanaele werden automatisch gesucht oder angelegt (#status, #chat,
# #stichwort-alarm, #logs, #microsoft-login). Eigene Kanaele per ID:
# DISCORD_STATUS_CHANNEL_ID=
# DISCORD_CHAT_CHANNEL_ID=
# DISCORD_ALERT_CHANNEL_ID=
# DISCORD_LOG_CHANNEL_ID=
# DISCORD_AUTH_CHANNEL_ID=

# Wer bei Stichwort-Treffern gepingt wird (Rollenname oder Rollen-ID)
# DISCORD_KEYWORD_PING=AFK Manager

# Port der Weboberflaeche
# WEB_PORT=3000

# Standard: Panel nur auf diesem Rechner erreichbar (http://localhost:3000).
# 0.0.0.0 = auch von Handy/PC im selben WLAN (http://<IP-des-Rechners>:3000)
# PANEL_HOST=0.0.0.0

# Nur hinter einem Proxy/Tunnel (z.B. Cloudflare) auf 1 setzen
# TRUST_PROXY=1
